# Cyrus AI - Ticketlayer AWS Deployment Configuration
# Custom configuration for deploying Cyrus with ticketlayer GitHub organization
#
# Setup Instructions:
# 1. Copy this file: cp .env.ticketlayer.example .env
# 2. Fill in the values marked with YOUR_* placeholders
# 3. Follow the setup steps in docs/TICKETLAYER_DEPLOYMENT.md

# ==============================================================================
# REQUIRED: Linear OAuth Configuration
# ==============================================================================
# Create Linear OAuth app at: https://linear.app/settings/api
#
# OAuth Application Settings:
#   Name: Cyrus
#   Callback URL: https://cyrus.yourdomain.com/callback
#   Webhook URL: https://cyrus.yourdomain.com/webhook
#   Enable: Client credentials ✓
#   Enable: Webhooks ✓
#   Webhook Events: Agent session events ✓

LINEAR_DIRECT_WEBHOOKS=true
LINEAR_CLIENT_ID=YOUR_LINEAR_CLIENT_ID_HERE
LINEAR_CLIENT_SECRET=YOUR_LINEAR_CLIENT_SECRET_HERE
LINEAR_WEBHOOK_SECRET=YOUR_LINEAR_WEBHOOK_SECRET_HERE

# ==============================================================================
# REQUIRED: Public URL Configuration
# ==============================================================================
# Your AWS EC2 instance with domain and nginx reverse proxy
# Example: https://cyrus.ticketlayer.com

CYRUS_BASE_URL=https://YOUR_DOMAIN_HERE
CYRUS_SERVER_PORT=3456

# ==============================================================================
# REQUIRED: Claude Code OAuth Token
# ==============================================================================
# Get your Claude Code OAuth token:
#
# On your local machine (where you have Claude Code installed):
#   1. Run: claude setup-token
#   2. This will display your OAuth token
#   3. Copy the token and paste it below
#
# Alternative method:
#   1. Find the token in ~/.config/claude/config.json
#   2. Look for the "oauth" section
#   3. Copy the "access_token" value

CLAUDE_CODE_OAUTH_TOKEN=YOUR_CLAUDE_OAUTH_TOKEN_HERE

# ==============================================================================
# OPTIONAL: Model Configuration
# ==============================================================================
# Recommended for production workloads

CYRUS_DEFAULT_MODEL=opus
CYRUS_DEFAULT_FALLBACK_MODEL=sonnet

# ==============================================================================
# OPTIONAL: Logging
# ==============================================================================
# Use 'info' for production, 'debug' for troubleshooting

CYRUS_LOG_LEVEL=info

# ==============================================================================
# DOCKER: Container Configuration
# ==============================================================================
# These are automatically set for Docker - no changes needed

CYRUS_HOME=/data/cyrus
CYRUS_HOST_EXTERNAL=true

# ==============================================================================
# TICKETLAYER REPOSITORIES
# ==============================================================================
# After initial setup, add your repositories using:
#
#   docker-compose exec cyrus cyrus self-add-repo \
#     git@github.com:ticketlayer/backstage-api.git \
#     "Ticketlayer Workspace"
#
#   docker-compose exec cyrus cyrus self-add-repo \
#     git@github.com:ticketlayer/backstage-app.git \
#     "Ticketlayer Workspace"
#
# Repositories will be cloned to: /data/cyrus/repos/
# Configuration stored in: /data/cyrus/config.json

# ==============================================================================
# NEXT STEPS
# ==============================================================================
#
# 1. Fill in all YOUR_* placeholders above
#
# 2. Set up AWS EC2 instance:
#    - Launch Ubuntu 22.04 instance (t3.medium or larger)
#    - Configure security group to allow ports 80, 443, 22
#    - Attach Elastic IP for stable IP address
#    - Configure DNS: cyrus.yourdomain.com → Elastic IP
#
# 3. Install Docker and dependencies on EC2:
#    ssh ubuntu@your-ec2-ip
#    sudo apt update && sudo apt install -y docker.io docker-compose-v2
#    sudo usermod -aG docker ubuntu
#
# 4. Set up nginx reverse proxy with SSL:
#    sudo apt install -y nginx certbot python3-certbot-nginx
#    sudo certbot --nginx -d cyrus.yourdomain.com
#
# 5. Deploy Cyrus:
#    git clone https://github.com/ceedaragents/cyrus.git
#    cd cyrus
#    cp .env.ticketlayer.example .env
#    # Edit .env with your values
#    docker-compose up -d --build
#
# 6. Configure GitHub SSH access:
#    ssh-keygen -t ed25519 -C "cyrus@ticketlayer.com"
#    # Add public key to GitHub deploy keys for each repo
#
# 7. Configure GitHub CLI for PR creation:
#    docker-compose exec cyrus gh auth login
#
# 8. Authorize with Linear:
#    docker-compose exec cyrus cyrus self-auth
#
# 9. Add repositories:
#    docker-compose exec cyrus cyrus self-add-repo \
#      git@github.com:ticketlayer/backstage-api.git "Ticketlayer Workspace"
#
# 10. Monitor logs:
#     docker-compose logs -f cyrus
#
# For detailed instructions, see: docs/TICKETLAYER_DEPLOYMENT.md
