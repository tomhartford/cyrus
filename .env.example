# Cyrus AI - Docker Environment Configuration
# Copy this file to .env and fill in your actual values
#
# For detailed setup instructions, see docs/DOCKER_DEPLOYMENT.md

# ==============================================================================
# REQUIRED: Linear OAuth Configuration
# ==============================================================================
# Create these in your Linear workspace settings:
# Settings > API > OAuth Applications
# See: docs/SELF_HOSTING.md#step-3-create-linear-oauth-application

LINEAR_DIRECT_WEBHOOKS=true
LINEAR_CLIENT_ID=your_linear_client_id_here
LINEAR_CLIENT_SECRET=your_linear_client_secret_here
LINEAR_WEBHOOK_SECRET=your_linear_webhook_secret_here

# ==============================================================================
# REQUIRED: Public URL Configuration
# ==============================================================================
# This must be a publicly accessible URL for Linear webhooks and OAuth callbacks
# Options:
#   - Cloudflare Tunnel: https://cyrus.yourdomain.com
#   - ngrok: https://abc123.ngrok.io (changes on restart)
#   - Public server: https://your-server.com
#   - Reverse proxy: https://cyrus.example.com

CYRUS_BASE_URL=https://your-public-url-here.com

# Server port (default: 3456)
CYRUS_SERVER_PORT=3456

# ==============================================================================
# REQUIRED: Claude Code Authentication
# ==============================================================================
# Choose ONE of the following options:

# Option 1: Anthropic API Key (Recommended for self-hosted)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Option 2: Claude Code OAuth Token (for Max subscription users)
# Run 'claude setup-token' on a machine with Claude Code installed
# CLAUDE_CODE_OAUTH_TOKEN=your-oauth-token-here

# Option 3: Third-party providers (Bedrock, Vertex AI, Azure)
# See: https://docs.anthropic.com/en/docs/claude-code/bedrock-vertex
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=us-east-1

# ==============================================================================
# OPTIONAL: Cloudflare Tunnel
# ==============================================================================
# If using Cloudflare Tunnel for public URL
# Get token from: https://one.dash.cloudflare.com/ > Access > Tunnels
# See: docs/CLOUDFLARE_TUNNEL.md

# CLOUDFLARE_TOKEN=eyJhIjoiXXXXXXX...your_cloudflare_tunnel_token_here

# ==============================================================================
# OPTIONAL: Model Configuration
# ==============================================================================
# Override default models (defaults: opus with sonnet fallback)

# CYRUS_DEFAULT_MODEL=opus
# CYRUS_DEFAULT_FALLBACK_MODEL=sonnet

# ==============================================================================
# OPTIONAL: OpenAI Integration
# ==============================================================================
# For Sora video generation and DALL-E image generation
# Get from: https://platform.openai.com/api-keys

# OPENAI_API_KEY=sk-your-openai-key-here

# ==============================================================================
# OPTIONAL: Logging and Debugging
# ==============================================================================
# Log level: debug, info, warn, error
# CYRUS_LOG_LEVEL=info

# Enable debug mode
# DEBUG=true

# ==============================================================================
# OPTIONAL: Tool Restrictions
# ==============================================================================
# Restrict which tools Claude can use globally
# See: docs/CONFIG_FILE.md for details

# ALLOWED_TOOLS=Read(**),Edit(**),Bash(git:*),Bash(gh:*),Task,WebSearch
# DISALLOWED_TOOLS=

# ==============================================================================
# DOCKER-SPECIFIC: Container Configuration
# ==============================================================================
# These are set automatically for Docker but can be overridden

# Cyrus home directory (mounted to /data/cyrus volume)
CYRUS_HOME=/data/cyrus

# Listen on all network interfaces in container
CYRUS_HOST_EXTERNAL=true

# ==============================================================================
# NOTES
# ==============================================================================
#
# 1. After filling in this file, rename it to .env:
#    cp .env.example .env
#
# 2. Never commit .env to version control - it contains secrets!
#
# 3. For initial setup, you'll need to authorize with Linear:
#    docker-compose exec cyrus cyrus self-auth
#
# 4. To add repositories after authorization:
#    docker-compose exec cyrus cyrus self-add-repo https://github.com/org/repo.git
#
# 5. To view logs:
#    docker-compose logs -f cyrus
#
# 6. For detailed setup instructions:
#    See docs/DOCKER_DEPLOYMENT.md
#
